<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0 carries Umbraco 13 (LTS); net10.0 carries Umbraco 17 and 18. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- See the sibling project for why the audit is scoped to direct dependencies. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <RootNamespace>Umbraco.Community.Imaging.ImageSharp</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbraco.Community.Imaging.ImageSharp2</PackageId>
    <Title>Umbraco Community Imaging (ImageSharp 2) — memory limits</Title>
    <Description>Stops Umbraco sites being OOM-killed in memory-limited containers while browsing the media section. This is the ImageSharp 2.x variant, for sites using Umbraco.Cms.Imaging.ImageSharp2; use Umbraco.Community.Imaging.ImageSharp for the default ImageSharp 3.x setup. Caps the unmanaged buffer pool ImageSharp retains and bounds how many images are processed concurrently, both derived from the memory available to the process.</Description>
    <Authors>Aaron Sadler</Authors>
    <Company>Aaron Sadler</Company>
    <Product>Umbraco.Community.Imaging.ImageSharp2</Product>
    <Copyright>Copyright © Aaron Sadler</Copyright>
    <PackageTags>umbraco umbraco-marketplace imagesharp imaging media memory docker container oom performance</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/AaronSadlerUK/Umbraco.Community.Imaging.ImageSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AaronSadlerUK/Umbraco.Community.Imaging.ImageSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>See https://github.com/AaronSadlerUK/Umbraco.Community.Imaging.ImageSharp/releases</PackageReleaseNotes>
    <Version>1.2.0</Version>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../LICENSE" Pack="true" PackagePath="\" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="\" />
    <None Include="../../umbraco-marketplace.imagesharp2.json" Pack="true" PackagePath="\umbraco-marketplace.json" />
  </ItemGroup>

  <!--
    Shared with the ImageSharp 3.x package rather than copied. The implementation touches only
    IImageWebProcessor.Commands, Configuration.Default.MemoryAllocator and MemoryAllocatorOptions,
    all of which exist in both ImageSharp majors, so one set of sources serves both packages and
    the two cannot drift.
  -->
  <ItemGroup>
    <Compile Include="..\Umbraco.Community.Imaging.ImageSharp\Configuration\ImagingMemorySettings.cs" Link="Configuration\ImagingMemorySettings.cs" />
    <Compile Include="..\Umbraco.Community.Imaging.ImageSharp\ImageProcessingThrottleMiddleware.cs" Link="ImageProcessingThrottleMiddleware.cs" />
    <Compile Include="..\Umbraco.Community.Imaging.ImageSharp\ImagingMemoryComposer.cs" Link="ImagingMemoryComposer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp2" Version="[13.0.0, 14.0.0)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Umbraco.Cms.Imaging.ImageSharp2" Version="[17.0.0, 19.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbraco.Community.Imaging.ImageSharp2.Tests" />
  </ItemGroup>

</Project>
